{
  "name": "celestial-media-hub",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Open-source full-stack media processing studio powered by Next.js, FFmpeg, and yt-dlp.",
  "homepage": "https://github.com/aradhyjain107/celestial-media-hub",
  "repository": {
    "type": "git",
    "url": "https://github.com/aradhyjain107/celestial-media-hub.git"
  },
  "private": true,
  "scripts": {
    "dev": "rm -rf .next-dev && next dev -p 3000",
    "build": "BROWSERSLIST_IGNORE_OLD_DATA=true rm -rf .next && BROWSERSLIST_IGNORE_OLD_DATA=true next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "test": "vitest run",
    "test:qa": "playwright test tests/visual/studio-qa.spec.ts"
  },
  "dependencies": {
    "framer-motion": "^12.38.0",
    "jose": "^6.2.8",
    "next": "14.2.35",
    "react": "^18",
    "react-dom": "^18",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/ui": "^4.1.0",
    "autoprefixer": "^10.5.0",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "eslint-plugin-security": "^1.7.1",
    "jsdom": "^29.0.1",
    "pixelmatch": "^7.1.0",
    "playwright": "^1.58.2",
    "pngjs": "^7.0.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^4.1.0"
  },
  "optionalDependencies": {
    "@next/swc-darwin-arm64": "14.2.33"
  }
}
