NEXT_PUBLIC_API_BASE_URL=
# Optional path overrides (auto-resolved from system PATH if left blank)
# macOS Homebrew example: /opt/homebrew/bin/ffmpeg
FFMPEG_PATH=
YTDLP_PATH=
TEMP_DIR=/tmp/celestial
# Required in production (min 32 chars). Generate with: openssl rand -base64 32
JWT_SECRET=
# Optional Spotify API credentials (falls back to public embed extraction when omitted)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
